# Copy this file to backend/.env and fill in the real values. Never commit
# the resulting .env file (see .gitignore).
#
# See README.md "Environment Variables" for a description of each variable.

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Database (Supabase Postgres connection string). Overridden by
# docker-compose.yml when running via `docker compose up`.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/novelengine

# Async job queue (Phase 2) — any Redis-compatible URL, including Upstash's
# Redis-compatible TCP endpoint. Overridden by docker-compose.yml locally.
REDIS_URL=redis://localhost:6379/0

# LLM
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.7
MAX_REVISION_LOOPS=5

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
